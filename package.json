{
  "name": "eyerecess",
  "productName": "EyeRecess",
  "version": "0.1.2",
  "description": "A local tray and menu bar app for regular screen breaks.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "npm run setup:electron",
    "setup:electron": "node scripts/dev/setup-electron.mjs",
    "start": "node scripts/dev/start.mjs",
    "win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/launch.ps1",
    "demo": "node scripts/dev/start.mjs --fast",
    "smoke": "node scripts/dev/start.mjs --smoke",
    "icons": "node scripts/dev/generate-icons.mjs",
    "icons:mac": "node scripts/dev/generate-mac-icon.mjs",
    "preview": "node scripts/dev/preview.mjs",
    "test": "node tests/unit/core.test.js && node tests/unit/security.test.js && node tests/integration/main.test.js && node tests/integration/breaks.test.js && node tests/integration/overlay.test.js && node tests/integration/start.test.js && node tests/integration/setup-electron.test.js && node tests/renderer/settings.test.js && node tests/renderer/overlay.test.js",
    "test:logic": "node tests/unit/core.test.js && node tests/unit/security.test.js",
    "test:boot": "node tests/integration/main.test.js && node tests/integration/breaks.test.js && node tests/integration/overlay.test.js",
    "test:settings": "node tests/renderer/settings.test.js && node tests/renderer/overlay.test.js",
    "fetch:electron": "npm run setup:electron",
    "app": "wscript EyeRecess.vbs",
    "predist:mac": "npm run icons:mac",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "predist": "npm run icons:mac",
    "dist": "electron-builder --mac --win --publish never",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "EyeRecess contributors",
  "homepage": "https://github.com/ningninger/eyerecess",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningninger/eyerecess.git"
  },
  "build": {
    "appId": "com.eyerecess.app",
    "productName": "EyeRecess",
    "copyright": "Copyright (c) 2026 EyeRecess contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "LICENSE"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "EyeRecess ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "EyeRecess"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
