{
  "name": "eyerecess",
  "productName": "EyeRecess",
  "version": "0.1.0",
  "description": "A tray/menu-bar eye-rest reminder (课间) that counts real screen-on work time instead of wall clock.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "demo": "electron . --fast",
    "smoke": "electron . --smoke",
    "icons": "node scripts/gen-icons.mjs",
    "preview": "node scripts/preview-ui.mjs",
    "test": "node scripts/test-logic.js && node scripts/test-boot.js",
    "test:logic": "node scripts/test-logic.js",
    "test:boot": "node scripts/test-boot.js",
    "fetch:electron": "node scripts/fetch-electron.mjs",
    "app": "wscript EyeRecess.vbs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "EyeRecess contributors",
  "homepage": "https://github.com/ningninger/eyerecess",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningninger/eyerecess.git"
  },
  "build": {
    "appId": "com.eyerecess.app",
    "productName": "EyeRecess",
    "copyright": "Copyright (c) 2026 EyeRecess contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "docs/spec.md",
      "package.json",
      "!**/*.map",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "EyeRecess ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "EyeRecess"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
