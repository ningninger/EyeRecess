* text=auto eol=lf

# Windows 批处理/脚本必须 CRLF：cmd.exe 与 PowerShell 5.1 都对换行敏感，
# 而且 cmd 无法解析 LF-only 的批处理（会把下一行吃掉）。
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.vbs  text eol=crlf
*.ps1  text eol=crlf

# 二进制：不要让 git 试图合并或转换
*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.zip  binary
*.dmg  binary
*.exe  binary
*.app  binary
